import matplotlib.pyplot as plt
X=[10,28,33,44]
Y=[4,65,89,9]
A=[10,20,60,42]
B=[12,45,89,90]

plt.plot(X,Y,"o--r",label="pahila graph")
plt.plot(A,B ,label="dusra graph")

plt.title("x aani y cha graph")

plt.xlabel("x cha graph")
plt.ylabel("kuch to on y")
plt.show()#we can also merge the two graphs and it apper in 2 colors then use label and legand for colors
plt.legend()
